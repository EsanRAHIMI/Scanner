# Same Atlas cluster as Trainer. Marketing collections live in this database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=lorenzodb

# Must match Trainer-Server
TRAINER_JWT_SECRET=CHANGE_ME
TRAINER_AUTH_COOKIE_NAME=trainer_auth

MARKETING_CORS_ORIGINS=http://localhost:3005,https://marketing.lorenzohome.ae

# Optional one-time workbook import on first boot
# MARKETING_WORKBOOK_PATH=/path/to/Lorenzo Marketing Performance & KPI Dashboard.xlsx

# Ads sync cadence (seconds). The dashboard itself always reads the stored snapshot.
SYNC_INTERVAL_SECONDS=3600

# --- Meta (account 449251307578659) ---
# META_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=449251307578659

