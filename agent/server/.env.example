# --- Agent database (dedicated; NOT the shared lorenzodb) ---
MONGODB_URI=********
MONGODB_DB_NAME=lorenzo_agent

# --- Shared platform DB (READ-ONLY) for product/proposal lookups ---
PLATFORM_DB_NAME=lorenzodb
# Image service base for the read-only image-status tool (e.g. http://image-server:8020)
# IMAGE_API_BASE=

# --- Shared auth (must match trainer/proposals) ---
TRAINER_JWT_SECRET=********
TRAINER_AUTH_COOKIE_NAME=trainer_auth

# --- Service ---
AGENT_PORT=8040
# Set ONLY if the reverse proxy forwards a base path without stripping it
# (e.g. it routes https://agent.example.com/server/* to this service WITHOUT
# removing "/server"). Leave empty when the proxy strips the prefix (typical).
# AGENT_ROOT_PATH=/server

# Comma-separated browser origins allowed to call the agent (with credentials).
# Local:
AGENT_CORS_ORIGINS=http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007,http://localhost:3010
# Production example:
# AGENT_CORS_ORIGINS=https://products.lorenzohome.ae,https://proposals.lorenzohome.ae,https://image.lorenzohome.ae,https://marketing.lorenzohome.ae,https://dashboard.lorenzohome.ae
# Future client example:
# AGENT_CORS_ORIGINS=https://products.client-domain.com,https://proposals.client-domain.com,...

# --- Nav shortcut URLs (floating bar); derived from domain if left unset ---
APP_BASE_DOMAIN=lorenzohome.ae
HUB_SUBDOMAIN=dashboard
# PRODUCTS_URL=https://products.lorenzohome.ae
# PROPOSALS_URL=https://proposals.lorenzohome.ae
# IMAGE_URL=https://image.lorenzohome.ae
# MARKETING_URL=https://marketing.lorenzohome.ae

# --- LLM (provider-agnostic; auto-detects by available key) ---
LLM_PROVIDER=openai         # auto | anthropic | openai | echo
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_API_KEY=********
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
