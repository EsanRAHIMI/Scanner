# MongoDB Atlas (required — all metadata lives here)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
IMAGE_MONGODB_DB=lorenzo_image

# Local disk cache for image bytes when S3 is disabled (metadata is NOT stored here)
IMAGE_STORAGE_ROOT=./storage
IMAGE_OUTPUT_WIDTH=1080
IMAGE_OUTPUT_HEIGHT=1440

# Background removal — preserve_detail keeps thin wires/crystals (no heavy alpha matting)
IMAGE_REMBG_MODEL=birefnet-general
IMAGE_REMBG_PRESERVE_DETAIL=true
IMAGE_REMBG_MASK_DILATE=1
IMAGE_REMBG_ALPHA_MATTING=false
IMAGE_REMBG_FOREGROUND_THRESHOLD=240
IMAGE_REMBG_BACKGROUND_THRESHOLD=8
IMAGE_REMBG_ERODE_SIZE=0
IMAGE_REMBG_MAX_DIMENSION=2048
IMAGE_REMBG_MIN_DIMENSION=1800

# ---- Cutout engine (provider-based, switchable without code changes) ----
# Engine:   self_hosted (local, default) | managed_api | hybrid
# Mode:     cpu (default) | gpu (reserved for future self-hosted GPU matting)
# Quality:  fast | balanced (default, == legacy output) | premium
#   premium = soft-alpha matting + edge-aware refine + foreground decontamination
#   (halo removal). Uses pymatting if installed, else a dependency-free fallback.
IMAGE_CUTOUT_ENGINE=self_hosted
IMAGE_PROCESSING_MODE=cpu
IMAGE_QUALITY_MODE=balanced

# Managed cutout API (optional premium quality / hybrid escalation)
IMAGE_MANAGED_API_ENABLED=false
IMAGE_MANAGED_API_PROVIDER=none          # photoroom | removebg | none
IMAGE_MANAGED_API_KEY=
IMAGE_MANAGED_API_TIMEOUT_S=30
# Hybrid: if the local cutout confidence is below this, try the managed API.
IMAGE_HYBRID_ESCALATE_BELOW=0.55
IMAGE_HYBRID_MANAGED_BUDGET=-1            # max managed calls per batch; -1 = unlimited

# ---- Standardized output renditions ----
IMAGE_RENDER_MASTER_PNG=true
IMAGE_RENDER_MASTER_WEBP=true
IMAGE_RENDER_WEB_WEBP=true
IMAGE_RENDER_WEB_AVIF=false              # needs pillow-avif-plugin (see requirements)
IMAGE_RENDER_BRANDED_JPEG=true          # branded product image on background
IMAGE_MASTER_MAX_DIMENSION=4096
IMAGE_WEB_MAX_DIMENSION=2048
IMAGE_WEBP_QUALITY=90
IMAGE_AVIF_QUALITY=60

# Amazon S3 (recommended in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_S3_BUCKET=lorenzo-free-image-db
AWS_S3_PUBLIC_BASE_URL=https://d197dzaiz6xu5x.cloudfront.net
AWS_S3_UPLOAD_PREFIX=uploads
AWS_S3_PROCESSED_PREFIX=processed
AWS_S3_FINAL_PREFIX=final
AWS_S3_BACKGROUNDS_PREFIX=backgrounds
AWS_S3_WATERMARKS_PREFIX=watermarks

# Google Drive import (service account JSON path)
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly

# CORS (comma-separated origins)
IMAGE_CORS_ORIGINS=http://localhost:3006,http://127.0.0.1:3006,https://image.lorenzohome.ae
