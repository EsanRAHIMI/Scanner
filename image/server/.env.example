# MongoDB Atlas (required — all metadata lives here)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
IMAGE_MONGODB_DB=lorenzo_image

# Local disk cache for image bytes when S3 is disabled (metadata is NOT stored here)
IMAGE_STORAGE_ROOT=./storage
IMAGE_OUTPUT_WIDTH=1080
IMAGE_OUTPUT_HEIGHT=1440

# Amazon S3 (recommended in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_S3_BUCKET=lorenzo-free-image-db
AWS_S3_PUBLIC_BASE_URL=https://d197dzaiz6xu5x.cloudfront.net
AWS_S3_UPLOAD_PREFIX=uploads
AWS_S3_PROCESSED_PREFIX=processed
AWS_S3_FINAL_PREFIX=final
AWS_S3_BACKGROUNDS_PREFIX=backgrounds

# Google Drive import (service account JSON path)
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly

# CORS (comma-separated origins)
IMAGE_CORS_ORIGINS=http://localhost:3006,http://127.0.0.1:3006,https://image.lorenzohome.ae
