# --- MongoDB Atlas (same cluster as trainer/server) [REQ] ---
MONGODB_URI=
# Shared platform database — proposal documents live in the `proposals` collection.
MONGODB_DB_NAME=lorenzodb

# --- Shared auth (must match trainer/server) [REQ] ---
TRAINER_JWT_SECRET=
# TRAINER_AUTH_COOKIE_NAME=trainer_auth

# --- Amazon S3 object storage [REQ in production] ---
# All uploaded images and exported PDFs are stored in S3 (never on the app host disk).
# Set PROPOSALS_REQUIRE_S3=1 on Dokploy/production so the service refuses local disk fallback.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# Optional CDN / public base (recommended): https://cdn.example.com or bucket website URL
AWS_S3_PUBLIC_BASE_URL=
# Root prefix inside the bucket (folder layout documented in proposals/README.md)
AWS_S3_PROPOSALS_PREFIX=proposals
PROPOSALS_REQUIRE_S3=0

# --- Local dev fallback only (ignored when S3 is configured) ---
PROPOSALS_STORAGE_ROOT=./storage

# --- Service [OPT] ---
# PROPOSALS_INTERNAL_BASE=http://127.0.0.1:8030
# PROPOSALS_PUBLIC_BASE=https://proposals.lorenzohome.ae
# PROPOSALS_CORS_ORIGINS=http://localhost:3007,http://127.0.0.1:3007
